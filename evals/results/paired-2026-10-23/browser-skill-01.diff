+{
+  "name": "browser-app",
+  "private": true,
+  "type": "module",
+  "packageManager": "bun@1.4.4",
+  "scripts": {
+    "build": "bun build --target=browser --format=iife src/main.tsx --outfile=public/app.js",
+    "check": "bun check --no-script",
